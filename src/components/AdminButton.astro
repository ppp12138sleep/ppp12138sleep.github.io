---
/**
 * 首页左下角的后台入口。
 * 做成小胶囊而不是大按钮：求职者看的是作品，不应该被"后台"抢走注意力，
 * 但你自己需要一眼能找到它。
 *
 * 静态构建（GitHub Pages）没有服务端，按钮会指向一个不存在的页面，
 * 所以那种模式下直接不渲染。
 */
const isStaticBuild = process.env.STATIC_BUILD === "1";
---

{
  !isStaticBuild && (
    <a class="admin-fab" href="/admin" title="进入后台修改内容">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6" />
        <path
          d="M19.4 13.5a7.6 7.6 0 0 0 0-3l2-1.5-2-3.4-2.3 1a7.6 7.6 0 0 0-2.6-1.5L14 2.6h-4l-.5 2.5a7.6 7.6 0 0 0-2.6 1.5l-2.3-1-2 3.4 2 1.5a7.6 7.6 0 0 0 0 3l-2 1.5 2 3.4 2.3-1a7.6 7.6 0 0 0 2.6 1.5l.5 2.5h4l.5-2.5a7.6 7.6 0 0 0 2.6-1.5l2.3 1 2-3.4-2-1.5Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
      </svg>
      <span>后台</span>
    </a>
  )
}