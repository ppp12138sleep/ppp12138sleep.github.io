---
import { site } from "../data/site.js";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32" fill="none">
          <defs>
            <linearGradient
              id="brand-g"
              x1="4"
              y1="2"
              x2="28"
              y2="30"
              gradientUnits="userSpaceOnUse"
            >
              <stop stop-color="#8BEEFF"></stop>
              <stop offset="1" stop-color="#2A86FF"></stop>
            </linearGradient>
          </defs>
          <path
            d="M16 2.6 27.6 9.3v13.4L16 29.4 4.4 22.7V9.3L16 2.6Z"
            stroke="url(#brand-g)"
            stroke-width="1.6"
            stroke-linejoin="round"></path>
          <path
            d="M16 9.2 22.4 13v7L16 23.6 9.6 20v-7L16 9.2Z"
            stroke="url(#brand-g)"
            stroke-width="1"
            stroke-linejoin="round"
            opacity=".5"></path>
          <circle cx="16" cy="16.2" r="2" fill="url(#brand-g)"></circle>
        </svg>
      </span>
      <span class="brand__name">
        {site.name}<span> · 嵌入式 / IoT</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a
        class="nav-cta nav-cta--icon"
        href={site.github}
        target="_blank"
        rel="noopener"
        aria-label={`GitHub 主页 ${site.githubHandle}`}
        title={`GitHub · ${site.githubHandle}`}
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <a class="nav-cta" href={site.resume} download>简历 ↓</a>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="打开导航菜单"
        data-nav-toggle
      >
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<!--
  抽屉面板必须放在 <header> 外面：
  header 上有 backdrop-filter，会给 position:fixed 的后代重新建立包含块，
  面板就会变成"相对 header 定位"，宽度和位置都不受控。
-->
<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <nav class="mobile-menu__list" aria-label="移动端导航">
    {
      site.sections.map((s, i) => (
        <a href={`/#${s.id}`}>
          <span class="mono">{String(i + 1).padStart(2, "0")}</span>
          <span class="mobile-menu__label">{s.label}</span>
          <span class="mobile-menu__arrow" aria-hidden="true">↓</span>
        </a>
      ))
    }
  </nav>
  <div class="mobile-menu__foot">
    <a href={site.github} target="_blank" rel="noopener">GitHub</a>
    <a href={site.resume} download>下载简历</a>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
      menu.classList.toggle("is-open", open);
      document.documentElement.classList.toggle("menu-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // 点任意链接后收起（锚点跳转时菜单不该挡着内容）
    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    // 拉宽到桌面尺寸时收起，避免残留在页面上
    window
      .matchMedia("(min-width: 761px)")
      .addEventListener("change", (e) => {
        if (e.matches) setOpen(false);
      });
  }
</script>