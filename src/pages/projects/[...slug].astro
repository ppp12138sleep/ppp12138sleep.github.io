---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const isWip = d.status === "wip";
---

<BaseLayout
  title={`${d.title} · ${site.name}`}
  description={d.summary}
  image={d.cover}
  type="article"
>
  <section class="page-top">
    <div class="container">
      <nav class="crumbs" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href="/#work">项目</a>
        <span aria-hidden="true">/</span>
        <span>{d.title}</span>
      </nav>

      <h1>{d.title}</h1>
      <p class="page-top__lead">{d.summary}</p>

      <div class="page-top__meta">
        <span>角色<b>{d.role}</b></span>
        <span>时间<b>{d.period}</b></span>
        <span>状态<b>{isWip ? "进行中" : "已完成"}</b></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <article class="prose">
        <Content />
      </article>

      <aside class="aside">
        <h2>项目速览</h2>
        <dl>
          <dt>角色</dt>
          <dd>{d.role}</dd>
          <dt>时间</dt>
          <dd>{d.period}</dd>
          <dt>状态</dt>
          <dd>{isWip ? "进行中" : "已完成"}</dd>
          <dt>技术栈</dt>
          <dd>
            <span class="chips">
              {d.tags.map((t) => <span class="chip">{t}</span>)}
            </span>
          </dd>
        </dl>

        {
          d.links?.repo && (
            <a class="btn btn--outline" href={d.links.repo} target="_blank" rel="noopener">
              查看代码 ↗
            </a>
          )
        }
        {
          d.links?.demo && (
            <a class="btn btn--outline" href={d.links.demo} target="_blank" rel="noopener">
              在线演示 ↗
            </a>
          )
        }
        <a class="btn btn--primary" href="/#contact">联系我</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="next-prev">
        <span>
          {
            prev ? (
              <a href={`/projects/${prev.id}/`}>← {prev.data.title}</a>
            ) : (
              <a href="/">← 返回首页</a>
            )
          }
        </span>
        <span>
          {
            next ? (
              <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
            ) : (
              <a href="/#work">全部项目 →</a>
            )
          }
        </span>
      </div>
    </div>
  </section>
</BaseLayout>
