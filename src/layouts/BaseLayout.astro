---
import { site } from "../data/site.js";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = site.seo.title,
  description = site.seo.description,
  image = "/img/og.png",
  type = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.nameEn,
  jobTitle: "嵌入式硬件 / 物联网方案",
  description: site.seo.description,
  email: `mailto:${site.email}`,
  url: site.url,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: site.school,
  },
  knowsAbout: [
    "嵌入式系统",
    "PCB 设计",
    "STM32",
    "ESP32",
    "MQTT",
    "物联网",
  ],
  sameAs: (site.links ?? [])
    .map((l) => l.url)
    .filter((u) => u && u.startsWith("http")),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#0F141B" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name} · 个人主页`} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${site.headlineAccent}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>

  <body>
    <div class="ambient" aria-hidden="true">
      <span class="ambient__grid"></span>
      <span class="ambient__glow ambient__glow--a"></span>
      <span class="ambient__glow ambient__glow--b"></span>
      <canvas class="ambient__particles" data-particles></canvas>
    </div>

    <a class="skip-link" href="#main">跳到主要内容</a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {site.placeholder && (
      <div class="demo-chip" role="note">
        <i></i>示例内容 · 替换占位文案后上线
      </div>
    )}

    <script>
      /* ---------- 滚动进入淡入（无 JS 时内容默认可见） ---------- */
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const root = document.documentElement;

      if (!reduce && "IntersectionObserver" in window) {
        root.classList.add("reveal-ready");
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // 进入视口时淡入，完全离开后复位：向上滑回去、再滑下来都会重新播放
              entry.target.classList.toggle("is-in", entry.isIntersecting);
            }
          },
          { rootMargin: "0px 0px -2% 0px", threshold: 0 },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      }

      /* ---------- 全站背景粒子网络 ---------- */
      (function particles() {
        const canvas = document.querySelector("[data-particles]");
        if (!canvas || reduce) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const LINK = 152;
        let w = 0;
        let h = 0;
        let raf = 0;
        let nodes = [];

        const resize = () => {
          w = window.innerWidth;
          h = window.innerHeight;
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const count = Math.max(30, Math.min(78, Math.round((w * h) / 19000)));
          nodes = Array.from({ length: count }, () => ({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 0.2,
            vy: (Math.random() - 0.5) * 0.2,
            r: Math.random() * 1.3 + 0.7,
          }));
        };

        const frame = () => {
          ctx.clearRect(0, 0, w, h);

          for (const n of nodes) {
            n.x += n.vx;
            n.y += n.vy;
            if (n.x < 0 || n.x > w) n.vx *= -1;
            if (n.y < 0 || n.y > h) n.vy *= -1;

            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fillStyle = "rgba(110, 226, 255, 0.75)";
            ctx.fill();
          }

          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const a = nodes[i];
              const b = nodes[j];
              const d = Math.hypot(a.x - b.x, a.y - b.y);
              if (d < LINK) {
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.strokeStyle = `rgba(79, 216, 255, ${(0.3 * (1 - d / LINK)).toFixed(3)})`;
                ctx.lineWidth = 1;
                ctx.stroke();
              }
            }
          }

          raf = requestAnimationFrame(frame);
        };

        resize();
        frame();

        let t = 0;
        window.addEventListener("resize", () => {
          window.clearTimeout(t);
          t = window.setTimeout(resize, 200);
        });

        document.addEventListener("visibilitychange", () => {
          cancelAnimationFrame(raf);
          if (!document.hidden) raf = requestAnimationFrame(frame);
        });
      })();

      /* ---------- 终端打字机 ---------- */
      (function terminal() {
        const box = document.querySelector("[data-terminal]");
        if (!box || reduce) return;

        const lines = Array.from(box.querySelectorAll("[data-type]"));
        if (!lines.length) return;

        const wait = (ms) => new Promise((r) => setTimeout(r, ms));
        let cancelled = false;
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) cancelled = true;
        });

        async function run() {
          await wait(450);
          for (const line of lines) {
            if (cancelled) return;
            const cmd = line.querySelector("[data-type-text]");
            const out = line.nextElementSibling;
            if (!cmd) continue;

            const full = cmd.textContent || "";
            cmd.textContent = "";
            line.classList.add("is-active");

            for (let i = 0; i < full.length; i++) {
              if (cancelled) return;
              cmd.textContent += full[i];
              await wait(38 + Math.random() * 40);
            }

            line.classList.remove("is-active");
            if (out && out.hasAttribute("data-out")) {
              out.classList.add("is-shown");
              await wait(260);
            }
          }
        }
        run();
      })();
    </script>
  </body>
</html>
